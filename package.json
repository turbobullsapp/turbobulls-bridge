{
  "name": "turbobulls-bridge",
  "version": "1.0.0",
  "description": "Fetch daily prices from your own market-data provider, with your own API key, on your own computer, for Turbobulls.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "turbobulls-bridge": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "PROTOCOL.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/cli.js",
    "dev": "tsc -p tsconfig.build.json && node dist/cli.js --dev",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "pnpm check:source && pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "prepublishOnly": "pnpm check",
    "check:source": "node scripts/check-source.mjs src"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/turbobullsapp/turbobulls-bridge.git"
  },
  "homepage": "https://github.com/turbobullsapp/turbobulls-bridge#readme",
  "bugs": {
    "url": "https://github.com/turbobullsapp/turbobulls-bridge/issues"
  },
  "keywords": [
    "turbobulls",
    "portfolio",
    "market-data",
    "eodhd",
    "twelvedata",
    "alphavantage",
    "finnhub"
  ],
  "packageManager": "pnpm@10.30.3+sha512.c961d1e0a2d8e354ecaa5166b822516668b7f44cb5bd95122d590dd81922f606f5473b6d23ec4a5be05e7fcd18e8488d47d978bbe981872f1145d06e9a740017",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "eslint": "10.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
